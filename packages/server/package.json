{
  "name": "@yahtzee/server",
  "private": true,
  "version": "0.1.0",
  "description": "Fastify + Socket.IO server that owns the game state and keeps the game history in SQLite",
  "type": "module",
  "exports": {
    "./protocol": "./src/protocol.ts",
    "./looks": "./src/looks.ts",
    "./api": "./src/history/api.ts"
  },
  "scripts": {
    "dev": "JOIN_PORT=5173 tsx watch src/index.ts",
    "start": "NODE_ENV=production tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "@yahtzee/game-logic": "*",
    "fastify": "^5.12.8",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "socket.io-client": "^4.8.4"
  }
}
